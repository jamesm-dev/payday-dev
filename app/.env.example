# Copy to .env for local development. Every value here stays empty: this file is committed.
#
# In production these are Netlify environment variables (Site configuration, Environment
# variables), never a file in this repository. See README.md, "Production".

# Where the data lives.
# - Production: Supabase's TRANSACTION pooler address (port 6543), postgres://... TLS is required
#   unless the address says otherwise; sslmode=disable, allow and prefer are refused outside
#   development.
# - Empty in development: a local database in .pglite/ (PGlite, a real Postgres in-process).
# - memory:// keeps everything in the process and loses it on exit (the tests use it).
# A *.db file name is refused (that was SQLite).
DATABASE_URL=
# The address the deploy's build migrates with: Supabase's SESSION pooler (port 5432). Only the
# build uses it (`pnpm db:migrate`); the running app never does. Left empty, the build falls back to
# DATABASE_URL. Not needed locally: a local database migrates itself when it opens.
DATABASE_MIGRATION_URL=
# Optional: path of a CA certificate (PEM) to verify the Postgres server against. A Supabase host
# needs none: the app bundles Supabase's root and verifies against it. For any other host, without
# it the connection is encrypted but the server's certificate is not verified.
DATABASE_CA_CERT_PATH=
# One-time code for registering the first owner in production. Set it as a Netlify environment
# variable. Entered on /signin; nothing needs it once the owner exists. Unset, production refuses to
# register. Development needs no code, so leave it empty locally.
OWNER_SETUP_CODE=
# Google sign-in, switched off while either is empty; set both in Netlify to switch it on.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser tests only; ignored by the Netlify build.
GOOGLE_TEST_PROVIDER=
