# Copy to .env for local development. Every value here stays empty: this file is committed.

# Path to the SQLite file. Local development: local.db. On Fly.io it is set in fly.toml.
DATABASE_URL=
# Litestream's metrics endpoint, polled for the backup age on /health. Leave empty locally.
LITESTREAM_METRICS_URL=
# One-time code for registering the first owner in production (a Fly secret: `fly secrets set`).
# Entered on /signin; nothing needs it once the owner exists. Unset, production refuses to register.
# Development needs no code, so leave it empty locally.
OWNER_SETUP_CODE=

# Payday reminders (Web Push). All three must be set, or reminders are off and the Reminders
# screen says why. Make the key pair once with:  npx web-push generate-vapid-keys
# The private key is a Fly secret (`fly secrets set`), never a file in this repo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https:// address a push service can reach you on, such as mailto:you@example.com.
VAPID_SUBJECT=

# --- Container only: read by Litestream, not the app. Fly secrets in production, never here. ---
# The S3-compatible bucket, its endpoint URL and region.
REPLICA_BUCKET=
REPLICA_ENDPOINT=
REPLICA_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
